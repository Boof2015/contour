#include "resource.h"
#include "version.h"
#include <windows.h>

IDI_CONTOUR ICON "assets/contour.ico"

1 VERSIONINFO
FILEVERSION CONTOUR_VERSION_NUMERIC
PRODUCTVERSION CONTOUR_VERSION_NUMERIC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Contour"
            VALUE "FileVersion", CONTOUR_VERSION_STRING
            VALUE "InternalName", "contour"
            VALUE "OriginalFilename", "contour.exe"
            VALUE "ProductName", "Contour"
            VALUE "ProductVersion", CONTOUR_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
